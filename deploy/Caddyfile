# UI y agente en el MISMO origen: el navegador no necesita CORS y la UI puede
# usar rutas relativas (/eve/v1/...).
#
# Los DOS prefijos del agente tienen que llegar sin reescribir la ruta. Un
# proxy que solo pasa /eve/ deja arrancar una sesion, pero el run se cuelga
# cuando el callback de workflow no puede volver.

sri.tu-dominio.com {
    encode gzip

    @agente path /eve/* /.well-known/workflow/*
    # El stream de sesion es SSE: sin buffering.
    reverse_proxy @agente 127.0.0.1:3000 {
        flush_interval -1
    }

    # La UI compilada. Es una SPA: todo lo demas cae en index.html.
    root * /srv/sri-agent/web/dist
    try_files {path} /index.html
    file_server
}
