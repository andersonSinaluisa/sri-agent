# /etc/sri-agent/env  —  chmod 600, propietario root:sri
#
# Contiene credenciales fiscales. No lo pongas en el repo ni en el WorkingDirectory.

# ── Acceso al modelo ────────────────────────────────────────────────────────
# Un model id en formato string sale por el AI Gateway de Vercel. Fuera de
# Vercel NO hay OIDC de proyecto, así que esta clave es OBLIGATORIA.
AI_GATEWAY_API_KEY=

# ── Autenticación del canal ─────────────────────────────────────────────────
# Sin estas dos variables el canal no acepta a nadie en producción.
SRI_AGENTE_USUARIO=
SRI_AGENTE_CLAVE=

# principalIds autorizados a aprobar una presentación. Con httpBasic el
# principalId es el usuario de arriba. Vacío = cualquiera que responda puede
# aprobar (la aprobación humana sigue siendo obligatoria).
SRI_APROBADORES=

# ── Sandbox ─────────────────────────────────────────────────────────────────
# "docker" | "microsandbox" | "vercel".
# Usá microsandbox si el VPS tiene /dev/kvm: es el único backend local que
# soporta allow-list por dominio y restringe el egress a *.sri.gob.ec.
SRI_SANDBOX_BACKEND=docker

# ── Salida de red del navegador ─────────────────────────────────────────────
# Solo si este host NO alcanza al SRI (comprobalo con curl). El navegador sale
# por este proxy; el resto del agente sale directo.
#
#   socks5://172.17.0.1:1080  tunel SSH en modo sandbox (la puerta de Docker,
#                             NO 127.0.0.1: el navegador corre en el contenedor)
#   socks5://127.0.0.1:1080   solo con SRI_EJECUCION=local
#   http://host:3128          proxy HTTP
# SRI_PROXY=

# ── Credenciales de SRI en línea ────────────────────────────────────────────
# Una por contribuyente: SRI_CRED_<RUC>="usuario:clave"
SRI_CRED_0953227857001=
