# Los scripts se editan en Windows y se ejecutan en Linux. Un CRLF en el
# shebang rompe el script con "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf
*.mjs text eol=lf
deploy/Caddyfile text eol=lf
deploy/*.service text eol=lf

# Los archivos de entorno se copian tal cual a /etc/sri-agent/env. Un CRLF
# hace que systemd deje un  al final de cada valor: la clave llega con un
# retorno de carro invisible y el portal la rechaza como si fuera incorrecta.
*.env text eol=lf
.env.example text eol=lf
.env.production.example text eol=lf
