# ── Dónde corre Chromium ────────────────────────────────────────────────────
# "sandbox" (por defecto) o "local".
#
# local  = Chromium corre en un proceso hijo del runtime, con el Playwright del
#          proyecto. Es la única forma de desarrollar en Windows sin Docker.
#          NO hay aislamiento ni restricción de red. Solo para desarrollo.
SRI_EJECUCION=local

# ── Capturas al modelo ──────────────────────────────────────────────────────
# Por defecto NO se le mandan imagenes al modelo: varios proveedores devuelven
# 400 al recibir una imagen en el resultado de una herramienta, y la imagen
# queda en el historial reenviandose en cada llamada. La UI muestra la captura
# igual, porque recibe la salida completa de la tool.
# Activalo solo con un modelo con vision que las acepte.
# SRI_CAPTURAS_AL_MODELO=1

# Credenciales de SRI en línea, una entrada por contribuyente.
# Formato: SRI_CRED_<RUC>="usuario:clave"
#
# Si la clave tiene $ # ( ) o comillas, usa la variante en base64: esos
# caracteres los maltratan los archivos de entorno y la clave llega cortada
# sin que nada avise. Generala con:
#   printf '%s' 'RUC:CLAVE' | base64 -w0
# y ponela asi (tiene prioridad sobre la de texto plano):
#   SRI_CRED_<RUC>_B64=...
SRI_CRED_1790012345001="1790012345001:mi-clave"

# Alternativa de un solo contribuyente:
# SRI_RUC=1790012345001
# SRI_USUARIO=1790012345001
# SRI_CLAVE=mi-clave

# Opcional: principalIds autorizados a aprobar una presentación.
# Sin esta variable, cualquiera que responda puede aprobar (la aprobación
# humana sigue siendo obligatoria).
# SRI_APROBADORES="oidc:usuario-contador"
